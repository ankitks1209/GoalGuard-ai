{
  "info": {
    "name": "GoalGuard synthetic API walkthrough",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Disposable synthetic API checks. No real AI callers, PayPal calls or actual owner finances. Run once against a fresh scripts/postman_fixture.py process. No payment routes are included."
  },
  "protocolProfileBehavior": {
    "followRedirects": false
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.environment.get(\"fixture_mode\") !== \"disposable-no-providers\" || !/^http:\\/\\/127\\.0\\.0\\.1:\\d+$/.test(pm.environment.get(\"base_url\") || \"\")) {",
          "  pm.execution.skipRequest();",
          "  throw new Error(\"Run only with scripts/postman_fixture.py and its disposable local environment.\");",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Authentication is required",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/v1/catalog",
        "description": "Authentication is required",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "const data = pm.response.json();",
              "pm.test(\"Missing credentials rejected\", () => pm.expect(data.reason).to.eql(\"unauthorized\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Agents cannot read owner plans",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/v1/plan",
        "description": "Agents cannot read owner plans",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{agent_a_token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
              "const data = pm.response.json();",
              "pm.test(\"Owner-only route rejected\", () => pm.expect(data.reason).to.eql(\"forbidden\"));",
              "pm.test(\"No financial record returned\", () => pm.expect(data).not.to.have.property(\"plan\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Purchases need a confirmed plan",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/v1/proposals",
        "description": "Purchases need a confirmed plan",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{agent_a_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"items\": [{\"sku\": \"mic-standard\", \"quantity\": 1}], \"request_key\": \"postman-mic\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "const data = pm.response.json();",
              "pm.test(\"No initial purchasing authority\", () => pm.expect(data.reason).to.eql(\"plan_required\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Owner previews synthetic protections",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/v1/plan/preview",
        "description": "Owner previews synthetic protections",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{owner_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"mode\":\"activate\",\"plan\":{{demo_plan}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test(\"Only actual cash funds capacity\", () => pm.expect(data.summary.available_cents).to.eql(35000));",
              "pm.test(\"Preview binds exact plan\", () => pm.expect(data.preview_hash).to.be.a(\"string\").and.not.empty);",
              "pm.variables.set(\"preview_hash\", data.preview_hash);",
              "pm.variables.set(\"reviewed_plan\", JSON.stringify(data.spec));"
            ]
          }
        }
      ]
    },
    {
      "name": "Preview has not activated the plan",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/v1/plan",
        "description": "Preview has not activated the plan",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
