              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test(\"Shared allocation denies conflicting cart\", () => { pm.expect(data.decision).to.eql(\"denied\"); pm.expect(data.reason).to.eql(\"budget_exceeded\"); });",
              "pm.test(\"One feasible alternative, no private balances\", () => { pm.expect(data.counteroffers).to.have.length(1); pm.expect(data.counteroffers[0].total_cents).to.eql(10000); pm.expect(data).not.to.have.property(\"available_cents\"); pm.expect(data).not.to.have.property(\"bills\"); });",
              "pm.variables.set(\"counteroffer_items\", JSON.stringify(data.counteroffers[0].cart.items));"
            ]
          }
        }
      ]
    },
