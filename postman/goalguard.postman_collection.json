            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test(\"Confirmed capacity is $350\", () => pm.expect(data.available_cents).to.eql(35000));",
              "pm.test(\"Confirmed plan is ready\", () => pm.expect(data.status).to.eql(\"ready\"));"
            ]
          }
        }
      ]
    },
    {
