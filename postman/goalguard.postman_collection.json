    },
    {
      "name": "Owner confirms the exact synthetic plan",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/v1/plan/confirm",
        "description": "Automatic confirmation is ONLY for the disposable synthetic fixture. This is not a real owner's consent.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{owner_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"mode\":\"activate\",\"plan\":{{reviewed_plan}},\"preview_hash\":\"{{preview_hash}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
