              "pm.test(\"Catalog is explicitly synthetic\", () => pm.expect(data.simulation).to.eql(\"synthetic_catalog\"));",
              "pm.test(\"All products are synthetic\", () => { pm.expect(data.products).to.have.length(4); data.products.forEach(p => pm.expect(p.synthetic).to.eql(true)); });"
            ]
          }
        }
      ]
