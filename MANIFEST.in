include .env.example CONTRIBUTING.md SECURITY.md agent-tools.json
include AGENTS.md CLAUDE.md .pre-commit-config.yaml
include docs/spec.md
recursive-include agent_docs *.md
recursive-include scripts *.py
recursive-include postman *.md *.json
