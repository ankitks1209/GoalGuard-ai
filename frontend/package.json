{
  "name": "goalguard-owner-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "lint": "npm run lint:code && npm run check:tokens",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "npm run typecheck && vite build",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "lint:code": "oxlint --deny-warnings src tests/browser vite.config.ts playwright.config.ts",
    "check:tokens": "python3 ../scripts/check_design_tokens.py",
    "test:browser": "playwright test",
    "test:a11y": "playwright test accessibility.spec.ts",
    "test:visual": "playwright test visual.spec.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "27.4.0",
    "oxlint": "1.88.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
